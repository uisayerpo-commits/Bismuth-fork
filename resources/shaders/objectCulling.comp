#extension GL_ARB_shading_language_include:require

#include "shared.h"

layout (local_size_x = CULLING_LOCAL_SIZE, local_size_y = 1, local_size_z = 1) in;

//// INDEX BUFFERS ////
STORAGE_BUFFER(INPUT_INDEX_BUFFER_BINDING) InputIndexBuffer {
    uint u_inputIndicies[];
};

STORAGE_BUFFER(CULLED_INDEX_BUFFER_BINDING) CulledIndexBuffer {
    uint u_culledIndicies[];
};

/*
    This buffer contains indicies into the input sprite buffer
    that are ordered by how they should be drawn on screen.
    This buffer can change depending on the blending states.
*/
STORAGE_BUFFER(SPRITE_REMAP_BUFFER_BINDING) SpriteRemapBuffer {
    uint u_spriteRemapIndicies[];
};

//// DRAW COMMANDS BUFFER ////

STORAGE_BUFFER(DRAW_COMMAND_BUFFER_BINDING) DrawCommandBuffer {
    DrawCommand u_drawCommands[];
};

//// DIAGNOSTICS ////
// Counters the CPU reads back every few seconds (see Renderer::logDiagnostics):
//  0: sprites on screen        1: alpha is 0 (not drawn)    2: NaN or infinity in the sprite data
//  3: almost black (drawn)     4: bright (drawn)             5: sum of the alpha of drawn sprites * 1000
//  6: drawn                    7: the object transform collapsed (determinant close to 0)
//  8: color channel alpha is 0 9: group opacity is 0       10: object opacity is 0   (can overlap)
// 11: only the channel alpha  12: only the group opacity   13: only the object opacity
layout (std430, binding = DIAGNOSTICS_BUFFER_BINDING) buffer DiagnosticsBuffer {
    uint u_diagnostics[DIAGNOSTICS_COUNTER_COUNT];
};

void collectDiagnostics(vec4 color, vec2 position, mat2 transform) {
    atomicAdd(u_diagnostics[0], 1u);

    bool broken = any(isnan(color)) || any(isinf(color)) || any(isnan(position)) || any(isinf(position)) ||
                  any(isnan(transform[0])) || any(isinf(transform[0])) || any(isnan(transform[1])) || any(isinf(transform[1]));
    if (broken) {
        atomicAdd(u_diagnostics[2], 1u);
        return;
    }

    if (color.a <= 0.0) {
        atomicAdd(u_diagnostics[1], 1u);
        return;
    }

    atomicAdd(u_diagnostics[6], 1u);
    atomicAdd(u_diagnostics[5], uint(clamp(color.a, 0.0, 1.0) * 1000.0));

    // color.rgb is multiplied by the alpha at this point
    float brightest = max(color.r, max(color.g, color.b)) / color.a;
    if (brightest < 0.02)
        atomicAdd(u_diagnostics[3], 1u);
    else if (brightest > 0.5)
        atomicAdd(u_diagnostics[4], 1u);

    if (abs(determinant(transform)) < 0.000001)
        atomicAdd(u_diagnostics[7], 1u);
}

// Why a sprite ends up with alpha 0, and which color channels the sprites use
void collectAlphaDiagnostics(uint colorChannel, float channelAlpha, float groupOpacity, float objectOpacity) {
    bool channelZero = channelAlpha <= 0.0;
    bool groupZero   = groupOpacity <= 0.0;
    bool objectZero  = objectOpacity <= 0.0;

    if (channelZero) atomicAdd(u_diagnostics[8], 1u);
    if (groupZero)   atomicAdd(u_diagnostics[9], 1u);
    if (objectZero)  atomicAdd(u_diagnostics[10], 1u);

    if (channelZero && !groupZero && !objectZero) atomicAdd(u_diagnostics[11], 1u);
    if (groupZero && !channelZero && !objectZero) atomicAdd(u_diagnostics[12], 1u);
    if (objectZero && !channelZero && !groupZero) atomicAdd(u_diagnostics[13], 1u);

    bool hidden = channelZero || groupZero || objectZero;
    uint base = hidden ? uint(DIAGNOSTICS_HIDDEN_CHANNEL_BASE) : uint(DIAGNOSTICS_DRAWN_CHANNEL_BASE);
    atomicAdd(u_diagnostics[base + colorChannel], 1u);
}

//// RAW SPRITE OUTPUT ////
#ifdef RAW_SPRITES_IN_TEXTURE
layout (rgba32f, binding = 0) writeonly uniform highp image2D u_rawSpriteImage;

void writeRawSpriteTexel(uint texel, vec4 value) {
    imageStore(u_rawSpriteImage, ivec2(int(texel % RAW_SPRITE_TEXTURE_WIDTH), int(texel / RAW_SPRITE_TEXTURE_WIDTH)), value);
}

void writeRawSprite(uint spriteIndex, vec4 color, vec2 position, mat2 localTransform) {
    uint first = spriteIndex * RAW_SPRITE_TEXELS;
    writeRawSpriteTexel(first,      color);
    writeRawSpriteTexel(first + 1u, vec4(position, localTransform[0]));
    writeRawSpriteTexel(first + 2u, vec4(localTransform[1], 0.0, 0.0));
}
#else
void writeRawSprite(uint spriteIndex, vec4 color, vec2 position, mat2 localTransform) {
    u_rawSprites[spriteIndex].position = position;
    u_rawSprites[spriteIndex].localTransform = localTransform;
    u_rawSprites[spriteIndex].color = color;
}
#endif

//// GLOBALS ////
uint objectFlags;
uint objectIndex;
uint spriteType;
vec2 objectPosition;
vec2 vertexOffset;
// Pass 1: how many indices this work group keeps for the normal and the additive pass
uint normalIndexCount = 0u;
uint blendIndexCount  = 0u;

//// HELPER FUNCTION PREDECLARATIONS ////
bool isObjectOnScreen();
float calculateAudioScale();
vec4 calculateInvisibleBlockColorAndOpacity(vec4 color);
vec4 applyHSV(HSV hsvValue, vec4 color);

//// PROCESS SPRITE FUNCTION ////
void processSprite(uint spriteIndex) {
    // Not drawn, until the end of this function says otherwise
    u_spriteStates[spriteIndex] = 0u;

    PreCulledSprite pcSprite = u_preCulledSprites[spriteIndex];

    //// APPLY GROUP COMBINATION STATE ////
    GroupCombinationState state = u_groupCombinationStates[pcSprite.groupCombinationIndex];
    objectPosition = state.positionalTransform * pcSprite.startPosition + state.offset;

    if (!isObjectOnScreen())
        return;

    InputSprite sprite = u_inputSprites[spriteIndex];
    objectIndex = sprite.objectIndex;
    
    ObjectInfo object = u_objects[sprite.objectIndex];

    objectFlags = uint(object.flags);

    //// APPLY LOCAL TRANSFORM ////
    mat2 objectLocalTransform = mat2(1.0);

    if ((objectFlags & OBJECT_FLAG_IS_STATIC_OBJECT) == 0u)
        objectLocalTransform = state.localTransform;

    if (object.rotationSpeed != 0.0) // TODO: Just supply rotation speed in radians instead
        objectLocalTransform = rotationMatrix(-object.rotationSpeed * u_timer / 180.0 * PI) * objectLocalTransform;

    if ((objectFlags & OBJECT_FLAG_USES_AUDIO_SCALE) != 0u)
        objectLocalTransform = scaleMatrix(calculateAudioScale()) * objectLocalTransform;

    //// CALCULATE OBJECT COLOR ////
    uint colorChannel = 0u;

    spriteType = sprite.spriteType;

    switch (spriteType) {
    case SPRITE_TYPE_GLOW:
    case SPRITE_TYPE_BASE:   colorChannel = object.baseColorChannelId; break;
    case SPRITE_TYPE_DETAIL: colorChannel = object.detailColorChannelId; break;
    case SPRITE_TYPE_BLACK:  colorChannel = uint(COLOR_CHANNEL_BLACK); break;
    }

    // Reading outside of the buffer can hang the GPU driver
    colorChannel = min(colorChannel, uint(COLOR_CHANNEL_COUNT - 1));

    vec4 color = RGBA_TO_VEC4(u_channelColors[colorChannel]);

    if (spriteType == SPRITE_TYPE_GLOW && (objectFlags & OBJECT_FLAG_SPECIAL_GLOW_COLOR) != 0u)
        color = vec4(u_specialLightBGColor, 1.0);
    
    if ((objectFlags & OBJECT_FLAG_IS_INVISIBLE_BLOCK) != 0u)
        color = calculateInvisibleBlockColorAndOpacity(color);

    if (spriteType == SPRITE_TYPE_BASE && (objectFlags & OBJECT_FLAG_HAS_BASE_HSV) != 0u) {
        color = applyHSV(object.baseHSV, color);
    } else if (spriteType == SPRITE_TYPE_DETAIL && (objectFlags & OBJECT_FLAG_HAS_DETAIL_HSV) != 0u) {
        color = applyHSV(object.detailHSV, color);
    }

    if ((u_gameStateFlags & GAME_STATE_COLLECT_DIAGNOSTICS) != 0u)
        collectAlphaDiagnostics(colorChannel, color.a, state.opacity, object.opacity);

    color.a *= state.opacity * object.opacity;
    color.rgb *= color.a;

    if ((u_gameStateFlags & GAME_STATE_COLLECT_DIAGNOSTICS) != 0u)
        collectDiagnostics(color, objectPosition, objectLocalTransform);

    if (color.a <= 0.0)
        return;

    //// SAVE DATA INTO RAW SPRITE BUFFER ////
    writeRawSprite(spriteIndex, color, objectPosition, objectLocalTransform);

    //// CHOOSE THE DRAW PASS ////
    // Sprites of color channels that are blending are drawn additively. The channels can start and stop
    // blending while the level plays, so this is decided here every frame.
    uint blendingChannel = min(sprite.blendingChannel, uint(COLOR_CHANNEL_COUNT - 1));

    if (BITMAP_GET(u_channelBlending, blendingChannel) != 0u) {
        blendIndexCount += sprite.indexCount;
        u_spriteStates[spriteIndex] = 2u;
    } else {
        normalIndexCount += sprite.indexCount;
        u_spriteStates[spriteIndex] = 1u;
    }
}

//// MAIN FUNCTION ////
#if CULLING_PASS == 1

// Pass 1: cull the sprites of the work group, write the raw sprites, count the indices
void main() {
    uint workGroupIndex = gl_GlobalInvocationID.x;

    // The dispatch is rounded up to a multiple of CULLING_LOCAL_SIZE
    if (workGroupIndex >= uint(u_workGroups.length()))
        return;

    WorkGroup workGroup = u_workGroups[workGroupIndex];

    for (uint i = workGroup.inputSpriteStart; i < workGroup.inputSpriteEnd; i++)
        processSprite(u_spriteRemapIndicies[i]);

    u_workGroupOutputs[workGroupIndex].normalIndexCount = normalIndexCount;
    u_workGroupOutputs[workGroupIndex].blendIndexCount  = blendIndexCount;
}

#elif CULLING_PASS == 2

// Pass 2: one invocation per layer. Gives every work group of the layer its place in the index
// buffer, in order, and writes the 2 draw commands of the layer (normal, then additive).
void main() {
    uint layerIndex = gl_GlobalInvocationID.x;
    if (layerIndex >= uint(u_layers.length()))
        return;

    LayerInfo layer = u_layers[layerIndex];
    uint end = layer.firstWorkGroup + layer.workGroupCount;

    uint normalTotal = 0u;
    uint blendTotal  = 0u;
    for (uint w = layer.firstWorkGroup; w < end; w++) {
        normalTotal += u_workGroupOutputs[w].normalIndexCount;
        blendTotal  += u_workGroupOutputs[w].blendIndexCount;
    }

    // Normal indices from the start of the layer's part of the buffer, blending ones up to its end
    uint normalBase = layer.indexBase;
    uint blendBase  = layer.indexBase + layer.indexTotal - blendTotal;

    uint normalNext = normalBase;
    uint blendNext  = blendBase;
    for (uint w = layer.firstWorkGroup; w < end; w++) {
        u_workGroupOutputs[w].normalOffset = normalNext;
        u_workGroupOutputs[w].blendOffset  = blendNext;
        normalNext += u_workGroupOutputs[w].normalIndexCount;
        blendNext  += u_workGroupOutputs[w].blendIndexCount;
    }

    u_drawCommands[layerIndex * 2u].count      = normalTotal;
    u_drawCommands[layerIndex * 2u].firstIndex = normalBase;
    u_drawCommands[layerIndex * 2u + 1u].count      = blendTotal;
    u_drawCommands[layerIndex * 2u + 1u].firstIndex = blendBase;
}

#else

// Pass 3: copy the indices of the sprites that are drawn to the place pass 2 reserved for them
void main() {
    uint workGroupIndex = gl_GlobalInvocationID.x;
    if (workGroupIndex >= uint(u_workGroups.length()))
        return;

    WorkGroup workGroup = u_workGroups[workGroupIndex];
    uint normalNext = u_workGroupOutputs[workGroupIndex].normalOffset;
    uint blendNext  = u_workGroupOutputs[workGroupIndex].blendOffset;

    for (uint i = workGroup.inputSpriteStart; i < workGroup.inputSpriteEnd; i++) {
        uint spriteIndex = u_spriteRemapIndicies[i];
        uint state = u_spriteStates[spriteIndex];
        if (state == 0u)
            continue;

        InputSprite sprite = u_inputSprites[spriteIndex];
        uint indexEnd = sprite.indexStart + sprite.indexCount;

        if (state == 1u) {
            for (uint j = sprite.indexStart; j < indexEnd; j++) {
                u_culledIndicies[normalNext] = u_inputIndicies[j];
                normalNext++;
            }
        } else {
            for (uint j = sprite.indexStart; j < indexEnd; j++) {
                u_culledIndicies[blendNext] = u_inputIndicies[j];
                blendNext++;
            }
        }
    }
}

#endif

//// HELPER FUNCTIONS ////
bool isObjectOnScreen() {
    vec2 offset = objectPosition - u_cameraPosition;
    // return dot(offset, offset) < 400;

    vec2 screenPos = vec2(dot(u_cameraRight, offset), dot(u_cameraUp, offset));

    const float leeway = 100.0;

    return screenPos.x >= -leeway &&
           screenPos.x <= u_cameraSize.x + leeway &&
           screenPos.y >= -leeway &&
           screenPos.y <= u_cameraSize.y + leeway;
}

float calculateAudioScale() {
    float scale;
    if ((objectFlags & OBJECT_FLAG_CUSTOM_AUDIO_SCALE) != 0u) {
        float minScale = u_objects[objectIndex].audioScaleMin;
        float maxScale = u_objects[objectIndex].audioScaleMax;
        scale = (u_audioScale - 0.1) * (maxScale - minScale) + minScale;
    } else
        scale = u_audioScale;

    if ((objectFlags & OBJECT_FLAG_IS_ORB) != 0u)
        scale = min(scale + 0.3, 1.2);
    return scale;
}

float getRelativeMod(float xPos, float left, float right, float offset) {
    float result = u_cameraViewSize.x * 0.5;

    if (xPos > result + u_cameraPosition.x)
        result = (result - (xPos - offset - u_cameraPosition.x - result)) * right;
    else
        result = (result - (result + u_cameraPosition.x - xPos - offset)) * left;

    return clamp(result, 0.0, 1.0);
}

vec2 calculateInvisibleBlockOpacity() {
    float centerLeftX  = u_winSize.x * 0.5 - 75.0;
    float centerRightX = centerLeftX + 110.0;
    float someScreenLeft = u_screenRight - centerRightX - 90.0;

    float fadePosX = objectPosition.x;
    if (fadePosX <= u_cameraUnzoomedX)
        fadePosX += u_objects[objectIndex].fadeMargin;
    else
        fadePosX -= u_objects[objectIndex].fadeMargin;
    
    float relMod = getRelativeMod(fadePosX, 0.02, 0.014285714, 0.0);

    // INVISIBLE BLOCK OPACITY IS INACCURATE AND I CAN'T SEEM TO FIGURE IT OUT, I'M GOING CRAZY

    float someWidth1;
    if (fadePosX <= centerRightX + u_cameraPosition.x)
        someWidth1 = (centerLeftX + u_cameraPosition.x - fadePosX) / max(centerLeftX - 30.0, 1.0);
    else
        someWidth1 = (fadePosX - u_cameraPosition.x - centerRightX) / max(someScreenLeft, 1.0);

    someWidth1 = clamp(someWidth1, 0.0, 1.0);

    return vec2(
        min(someWidth1 * 0.95 + 0.05, relMod),
        min(someWidth1 * 0.85 + 0.15, relMod)
    );
}

vec4 calculateInvisibleBlockColorAndOpacity(vec4 color) {
    if ((u_gameStateFlags & GAME_STATE_IS_PLAYER_DEAD) != 0u) {
        if (spriteType == SPRITE_TYPE_GLOW)
            return vec4(u_specialLightBGColor, color.a);
        return color;
    }

    vec2 opacity = calculateInvisibleBlockOpacity();

    if (spriteType != SPRITE_TYPE_GLOW) {
        color.a *= opacity.x;
    } else {
        // Might have to do some of these calculations on the cpu instead
        vec3 colorBG  = RGBA_TO_VEC4(u_channelColors[COLOR_CHANNEL_BG]).rgb;
        vec3 colorLBG = RGBA_TO_VEC4(u_channelColors[COLOR_CHANNEL_LBG]).rgb;

        vec3 colorB;
        if ((colorBG.r + colorBG.g + colorBG.b) >= (150.0 / 255.0))
            colorB = vec3(1, 1, 1);
        else
            colorB = colorLBG;

        vec3 glowColor;
        if (opacity.x <= 0.8)
            glowColor = u_specialLightBGColor;
        else
            glowColor = mix(colorB, u_specialLightBGColor, (1.0 - (opacity.x - 0.8) / 0.2) * 0.3 + 0.7);
        color = vec4(glowColor, color.a * opacity.y);
    }

    return color;
}